# local-llamacpp-1650ti-qwen352b-q4_0 — authoritative configuration.
#
# The directory name is documentation; this file decides. Never copy a slot value
# out of the directory name into a CLI flag (NAMING.md, "The name is a claim").
# `1650ti` is for humans; llama.cpp never sees it, and CUDA_VISIBLE_DEVICES below
# is the value that actually selects the card.
#
# Committed on purpose and deliberately NOT gitignored. A real environment
# variable always wins over it: Makefiles use ?= and dotenv does not overwrite.
#
# FORKED 2026-10-16 from local-llamacpp-3050oem-qwen352b-q4_0. Slot 3 is the only
# slot that differs: same model, runtime, llama.cpp commit and serving flags, on the
# GTX 1650 Ti that serves local-llamacpp-1650ti-2b-q4_0. One host-side difference:
# HOST is loopback, as on every rig on this laptop. No drafter.

# ── Model ────────────────────────────────────────────────────────────────────
# Qwen/Qwen3.5-2B (revision 15852e8c, Apache-2.0), the smallest Qwen near Gemma 4
# E2B: 2,274,069,824 parameters in the safetensors with the vision tower, 1.943B
# in the text-only GGUF (llama-bench). 24 layers, three of every four Gated DeltaNet (linear
# attention) and every fourth full attention, 8 query / 2 KV heads of 256, vocab
# 248,320 with tied input/output embeddings, trained context 262,144.
# BUILT ON THIS HOST 2026-10-16 on llama.cpp 7182ef71e, `make quantize`:
#   convert_hf_to_gguf.py --outtype bf16   -> 3,897,388,000 B, 335 tensors
#   llama-quantize ... Q4_0 (no imatrix)   -> 1,236,741,088 B
# llama-quantize's standard Q4_0 mix: 194 matrices Q4_0 (806.4 MB), token_embd
# Q6_K (417.2 MB, which is also the output head since it is tied), 140 F32 norms
# and small tensors (2.2 MB). The file carries Qwen's MTP layer (blk.24.nextn.*),
# which nothing uses unless speculative decoding is turned on.
# No Qwen-published GGUF exists; MODEL_SHA256 pins this host's build.
# THE HASH DIFFERS FROM THE 3050 HOST'S (1c27608b...) at the same revision, the same
# llama.cpp commit and the same byte count; the bf16 GGUF differs too (ecbfdc76...
# here, 1526c207... there), so the difference enters at convert_hf_to_gguf.py, not
# at llama-quantize. Cause untested: the 3050 host was unreachable to diff against.
# Its effect measured: on 65 suite prompts the two hosts' Q4_0 logits pick the same
# label 62 times, median label-probability gap 0.018 (Q4_0 against fp32 is 0.115),
# and both match the fp32 reference on 43
# (benchmarks/runs/2026-10-16-parity-crosshost-1650ti).
MODEL_NAME=Qwen/Qwen3.5-2B
MODEL_HF_REVISION=15852e8c16360a2fea060d615a32b45270f8a8fc
MODEL_HF_DIR=/home/xbill/models/Qwen3.5-2B
MODEL_BF16_PATH=/home/xbill/models/Qwen3.5-2B-gguf/Qwen3.5-2B-bf16.gguf
MODEL_PATH=/home/xbill/models/Qwen3.5-2B-gguf/Qwen3.5-2B-Q4_0.gguf
MODEL_SHA256=bd99d5aec3cbe960a88d8616341aba2bedd57359abf90fdaf454a66c81055d5e

# Slot 5 of the directory name: the file's own name for its type (general.file_type
# Q4_0), as NAMING.md asks for GGUF builds. Not every tensor is Q4_0; see above.
QUANTIZATION=q4_0

# ── Hardware ─────────────────────────────────────────────────────────────────
# Same card and host as local-llamacpp-1650ti-2b-q4_0. MEASURED-STATIC 2026-10-16
# (benchmarks/runs/2026-10-16-first-light-1650ti/gpu-static.txt): TU117, Turing,
# sm_75, no tensor cores, 4096 MiB. Host: laptop `yogagpu`, 12 threads, 15 GiB RAM.
ACCELERATOR_TYPE="NVIDIA GeForce GTX 1650 Ti with Max-Q Design"
COMPUTE_CAPABILITY=7.5
VRAM_TOTAL_MIB=4096
# VRAM_FREE_MIB is the 2b sibling's 2026-09-03 reading, not re-measured.
VRAM_FREE_MIB=3724
NVIDIA_DRIVER=615.71.09
CUDA_VISIBLE_DEVICES=0
TENSOR_PARALLEL_SIZE=1

# ── Runtime ──────────────────────────────────────────────────────────────────
# This host's ~/llama.cpp checkout, built for sm_75 (`llama-server --version`:
# build 909, commit 7182ef7), the same commit as the 3050 sister. Gemma's sibling
# local-llamacpp-1650ti-2b-q4_0 records f95b0d9; the first-light run benched both
# models on this one binary.
LLAMA_CPP_DIR=/home/xbill/llama.cpp
LLAMA_CPP_COMMIT=7182ef71e
LLAMA_SERVER_BIN=/home/xbill/llama.cpp/build/bin/llama-server

# ── Serving ──────────────────────────────────────────────────────────────────
# Loopback only, as every rig on this laptop serves (the 3050 sister listens on
# 0.0.0.0). Port 8080 is shared with every local-llamacpp-* rig.
HOST=127.0.0.1
PORT=8080
ENDPOINT=http://127.0.0.1:8080

N_GPU_LAYERS=99

# 131,072, the 3050 sister's value; it fits this 4 GiB card because only 6 layers
# hold a KV cache (2951 MiB of 4096 MEASURED 2026-10-16). Gemma's sibling on this
# card serves 8,192. Qwen's trained maximum is 262,144. Only the 6 full-attention layers hold a KV cache
# (2 KV heads x 256, K+V f16 = 12 KiB per token, arithmetic); the 18 DeltaNet
# layers keep a fixed-size state per slot.
CONTEXT_SIZE=131072

# MEASURED 2026-10-16 (benchmarks/runs/2026-10-16-first-light-1650ti): -fa 1 is
# 1.007x prefill at pp512 and pp2048 and 1.013x decode against -fa 0. f16 KV
# carried from the sister, unmeasured on this model. Serving at the values below:
# 2951 MiB of 4096.
KV_CACHE_TYPE=f16
FLASH_ATTENTION=1
METRICS=1
THREADS=6
THREADS_BATCH=12
PARALLEL_SLOTS=1

# Qwen3.5 thinks by default; OFF so answers arrive in `content`, as on the sibling.
# A request can still turn it on with "chat_template_kwargs": {"enable_thinking": true}.
REASONING=off

GGML_CUDA_FORCE_MMQ=OFF

# Gemma's per_layer_token_embd has no counterpart here. Empty.
OVERRIDE_TENSORS=

# ── Speculative decoding ─────────────────────────────────────────────────────
# OFF. The GGUF carries Qwen's own MTP layer; the 3050 sister measured it at 1.15x
# greedy with 1 drafted token. Untested on this card.
SPEC_DRAFT_MODEL=
SPEC_DRAFT_N_MAX=2
