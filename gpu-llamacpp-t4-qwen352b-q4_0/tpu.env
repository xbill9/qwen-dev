# gpu-llamacpp-t4-qwen352b-q4_0 — authoritative configuration.
#
# The directory name is documentation; this file decides. Never copy a slot value
# out of the directory name into a CLI flag (NAMING.md, "The name is a claim").
# `t4` is for humans; llama.cpp never sees it, and CUDA_VISIBLE_DEVICES below
# is the value that actually selects the card.
#
# Committed on purpose and deliberately NOT gitignored. A real environment
# variable always wins over it: Makefiles use ?= and dotenv does not overwrite.
#
# FORKED 2026-10-19 from local-llamacpp-1650ti-qwen352b-q4_0. Slots 1 and 3 differ:
# the card is the Tesla T4 attached to the Compute Engine VM `debian13`
# (n1-standard-2, us-west2-b) that serves the gpu-vllm-t4-* rigs, so slot 1 is
# `gpu` (NAMING.md: a cloud VM keeps its platform value), as for gpu-vllm-t4-2b.
# Same model, runtime, llama.cpp commit and serving flags as the sister, except
# -t 2 -tb 2: this VM has 2 vCPUs. No drafter.
#
# THE vLLM SERVER ON THIS VM HOLDS THE SAME CARD (13.6 GiB) and port 8000; stop it
# first with `~/bin/vllm-t4 stop`, start it again with `~/bin/vllm-t4 start`.

# ── Model ────────────────────────────────────────────────────────────────────
# Qwen/Qwen3.5-2B (revision 15852e8c, Apache-2.0). See the sister's tpu.env for the
# architecture. BUILT ON THIS HOST 2026-10-19 on llama.cpp 7182ef71e:
#   convert_hf_to_gguf.py --outtype bf16   -> 3,897,388,000 B, sha256 dc07c774...
#   llama-quantize ... Q4_0 (no imatrix)   -> 1,236,741,088 B, sha256 d2bc253a...
# Both files are the same size as the other hosts' (Q4_0: 1650 Ti bd99d5ae..., 3050
# 1c27608b...). The bf16 GGUF is the same size as the 1650 Ti host's (ecbfdc76...) and the 3050
# host's (1526c207...) and hashes differently from both. Converting twice on this
# host gives identical bytes, so the converter is deterministic per host and the
# difference comes from the software around it (here: Python 3.12.13, torch
# 2.14.1+cpu, numpy 2.5.4, transformers 5.20.1, gguf-py from the same checkout).
# Which tensors differ is untested: the other hosts' files are not reachable here.
MODEL_NAME=Qwen/Qwen3.5-2B
MODEL_HF_REVISION=15852e8c16360a2fea060d615a32b45270f8a8fc
MODEL_HF_DIR=/opt1/models/Qwen3.5-2B
MODEL_BF16_PATH=/opt1/models/Qwen3.5-2B-gguf/Qwen3.5-2B-bf16.gguf
MODEL_PATH=/opt1/models/Qwen3.5-2B-gguf/Qwen3.5-2B-Q4_0.gguf
MODEL_SHA256=d2bc253a942eb422bb995b1ac39b67a897ff9861421682549e804517fc5d9ad8

# Slot 5 of the directory name: the file's own name for its type (general.file_type
# Q4_0), as NAMING.md asks for GGUF builds. Not every tensor is Q4_0.
QUANTIZATION=q4_0

# ── Hardware ─────────────────────────────────────────────────────────────────
# MEASURED-STATIC 2026-10-19 (nvidia-smi): Tesla T4, TU104, Turing, sm_75, tensor
# cores, 15360 MiB (14928 MiB free with nothing loaded), 70 W cap, 1590 MHz max SM.
# Host: GCE n1-standard-2, 2 vCPU Xeon @ 2.00GHz, 7.3 GiB RAM, 16 GiB /opt1/swapfile.
# The root disk is 32 GB and nearly full, so models, llama.cpp and the CUDA toolkit
# live on /opt1.
ACCELERATOR_TYPE="Tesla T4"
COMPUTE_CAPABILITY=7.5
VRAM_TOTAL_MIB=15360
VRAM_FREE_MIB=14928
NVIDIA_DRIVER=615.71.09
CUDA_VISIBLE_DEVICES=0
TENSOR_PARALLEL_SIZE=1

# ── Runtime ──────────────────────────────────────────────────────────────────
# /opt1/llama.cpp at 7182ef71e, the commit of both sisters, built for sm_75 with
# CUDA 13.4 (apt cuda-nvcc-13-4, installed under /opt1/cuda-13.4 through the
# /usr/local/cuda-13.4 symlink).
LLAMA_CPP_DIR=/opt1/llama.cpp
LLAMA_CPP_COMMIT=7182ef71e
LLAMA_SERVER_BIN=/opt1/llama.cpp/build/bin/llama-server

# ── Serving ──────────────────────────────────────────────────────────────────
# Loopback only, as the vLLM rigs on this VM serve. Port 8080 is the llama.cpp
# rigs' port; vLLM holds 8000.
HOST=127.0.0.1
PORT=8080
ENDPOINT=http://127.0.0.1:8080

N_GPU_LAYERS=99

# 131,072, the sisters' value. Only the 6 full-attention layers hold a KV cache
# (12 KiB per token f16, arithmetic); the 18 DeltaNet layers keep a fixed state.
CONTEXT_SIZE=131072

# Carried from the sisters; -fa on this card measured in
# benchmarks/runs/2026-10-19-first-light-t4.
KV_CACHE_TYPE=f16
FLASH_ATTENTION=1
METRICS=1
# 2 vCPUs. The sisters run -t 6 -tb 12.
THREADS=2
THREADS_BATCH=2
PARALLEL_SLOTS=1
# llama-server's host-RAM prompt cache (-cram) defaults to 8,192 MiB, more than this
# VM's 7.3 GiB. MEASURED 2026-10-19: at the default, -c 32768 --parallel 8 on Qwen
# reached 6.0 GB resident and 6 GB of swap within two minutes (each Qwen entry is
# ~41 MiB). 2048 holds it near 3.5 GB. The sisters' hosts have the RAM and keep the
# default. The prompt cache changes no score
# (local-llamacpp-3050oem-2b-q4_0/benchmarks/runs/2026-10-14-accuracy-cache-3050oem).
CACHE_RAM=2048

# Qwen3.5 thinks by default; OFF so answers arrive in `content`, as on the sisters.
REASONING=off

GGML_CUDA_FORCE_MMQ=OFF

# Gemma's per_layer_token_embd has no counterpart here. Empty.
OVERRIDE_TENSORS=

# ── Speculative decoding ─────────────────────────────────────────────────────
# OFF. The GGUF carries Qwen's own MTP layer (--spec-type draft-mtp, no -md);
# measured on this card in benchmarks/runs/2026-10-19-spec-mtp-vs-gemma-t4.
SPEC_DRAFT_MODEL=
SPEC_DRAFT_N_MAX=1
